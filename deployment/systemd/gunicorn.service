[Unit]
Description=Gunicorn daemon for Enterprise College ERP
After=network.target postgresql.service redis.service

[Service]
User=erpuser
Group=www-data
WorkingDirectory=/var/www/college-erp/backend
ExecStart=/var/www/college-erp/venv/bin/gunicorn --access-logfile - --workers 4 --threads 2 --bind unix:/run/gunicorn.sock config.wsgi:application
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
