# PRODUCTION ENVIRONMENT SPECIFICATION
DEBUG=False
SECRET_KEY=prod_secure_random_key_replace_in_vault
ALLOWED_HOSTS=erp.college.edu,api.college.edu
CORS_ALLOWED_ORIGINS=https://erp.college.edu

DATABASE_URL=postgres://erp_prod_user:prod_db_pass_99@postgres:5432/college_erp_prod
REDIS_URL=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=notifications@college-erp.org

USE_S3=True
AWS_STORAGE_BUCKET_NAME=prod-college-erp-media
AWS_S3_REGION_NAME=us-east-1
