# College ERP Workspace Environment Configuration
# Copy this file to .env and customize secrets for deployment.

# Secret Key & Security
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
POSTGRES_DB=college_erp
POSTGRES_USER=college_erp
POSTGRES_PASSWORD=college_erp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://college_erp:college_erp@postgres:5432/college_erp

# Caching & Background Task Broker (Redis & Celery)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=college-erp-assets
MINIO_USE_SSL=False

# Local AI Engine (Ollama)
OLLAMA_URL=http://localhost:11434

# Authentication Tokens (JWT)
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Service
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=secret
EMAIL_USE_TLS=True

# Frontend & Backend Base URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
