# Enterprise College ERP Environment Configurations

# Django Core
DEBUG=False
SECRET_KEY=change_me_to_high_entropy_production_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,erp.college.edu,api.college.edu
CORS_ALLOWED_ORIGINS=https://erp.college.edu

# Database & Cache
DATABASE_URL=postgres://erp_user:secure_password@localhost:5432/college_erp
REDIS_URL=redis://localhost:6379/0

# Email SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=noreply@college-erp.org

# AWS S3 Storage
USE_S3=False
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=college-erp-media
AWS_S3_REGION_NAME=us-east-1

# OpenAI Integration
OPENAI_API_KEY=sk-proj-your_openai_api_key
